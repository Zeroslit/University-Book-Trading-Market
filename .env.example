# ===== Docker Compose 环境变量样例 =====
# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=campus_book
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# 对外端口
API_PORT=3000
WEB_PORT=8080

# 鉴权与加密（生产环境必须替换为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
AES_KEY=please-change-me-32-bytes-length!!
HMAC_SECRET=please-change-me-hmac-secret

# 短信：console | mock（开发环境固定验证码 123456）
SMS_PROVIDER=console
SMS_DEV_CODE=123456

# 一期禁止接入真实支付
PAYMENT_MOCK=true
WECHAT_MOCK=true
