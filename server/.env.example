# 服务配置
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# 数据库（docker compose 默认 3306；本地便携版 MySQL 用 3307）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=campus_book
DB_POOL=10

# Redis（不可用时开发环境自动降级为内存实现）
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 鉴权与加密（生产必须替换）
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
AES_KEY=dev-aes-key-32-bytes-length!!!
HMAC_SECRET=dev-hmac-secret-change-me

# 短信：console | mock | aliyun（开发环境固定验证码 123456）
SMS_PROVIDER=console
SMS_DEV_CODE=123456

# 一期禁止接入真实支付
PAYMENT_MOCK=true
WECHAT_MOCK=true

# 图片上传
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE=/static
UPLOAD_MAX_MB=5

# 定时任务
JOBS_ENABLED=true
JOBS_TICK_SECONDS=60
